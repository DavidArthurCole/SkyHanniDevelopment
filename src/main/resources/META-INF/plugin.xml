<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>skyhanni.plugin</id>
    <name>SkyHanni Development</name>
    <vendor>SkyHanniStudios</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.SkyHanniBundle</resource-bundle>

    <!-- We need to specify that we support K2 mode -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="false" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Must be declared so NotificationGroupManager can find it at runtime -->
        <notificationGroup
            id="SkyHanni Plugin"
            displayType="BALLOON"
            isLogByDefault="false"
            key="notification.group.skyhanni"/>

        <!-- Inlay hints -->
        <codeInsight.declarativeInlayProvider
            language="kotlin"
            implementationClass="skyhanni.plugin.areas.event.EventHandlerInlayHintsProvider"
            isEnabledByDefault="true"
            group="OTHER_GROUP"
            providerId="skyhanni.event.primaryfunction.hint"
            nameKey="inlay.hints.event.primaryfunction.name"
            bundle="messages.SkyHanniBundle"/>

        <codeInsight.declarativeInlayProvider
            language="kotlin"
            implementationClass="skyhanni.plugin.areas.config.ConfigPathInlayHintsProvider"
            isEnabledByDefault="true"
            group="OTHER_GROUP"
            providerId="skyhanni.config.path"
            nameKey="inlay.hints.config.path.name"
            bundle="messages.SkyHanniBundle"/>

        <!-- Line markers -->
        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="skyhanni.plugin.areas.misc.Regex101LineMarkerProvider"/>

        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="skyhanni.plugin.areas.event.EventHandlerLineMarkerProvider"/>

        <!-- Inspections -->
        <localInspection
            language="kotlin"
            groupKey="inspection.group.skyhanni"
            key="inspection.handleEvent.displayName"
            bundle="messages.SkyHanniBundle"
            shortName="HandleEventInspection"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="skyhanni.plugin.areas.event.HandleEventInspection"/>

        <localInspection
            language="kotlin"
            groupKey="inspection.group.skyhanni"
            key="inspection.handleEventVisibility.displayName"
            bundle="messages.SkyHanniBundle"
            shortName="HandleEventVisibility"
            enabledByDefault="true"
            level="WEAK WARNING"
            implementationClass="skyhanni.plugin.areas.event.HandleEventVisibilityInspection"/>

        <localInspection
            language="kotlin"
            groupKey="inspection.group.skyhanni"
            key="inspection.missingPrimaryFunction.displayName"
            bundle="messages.SkyHanniBundle"
            shortName="MissingPrimaryFunction"
            enabledByDefault="true"
            level="WEAK WARNING"
            implementationClass="skyhanni.plugin.areas.event.primary.MissingPrimaryFunctionInspection"/>

        <localInspection
            language="kotlin"
            groupKey="inspection.group.skyhanni"
            key="inspection.mismatchedPrimaryFunction.displayName"
            bundle="messages.SkyHanniBundle"
            shortName="MismatchedPrimaryFunctionName"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="skyhanni.plugin.areas.event.primary.MismatchedPrimaryFunctionInspection"/>

        <localInspection
            language="kotlin"
            groupKey="inspection.group.skyhanni"
            key="inspection.duplicatePrimaryFunction.displayName"
            bundle="messages.SkyHanniBundle"
            shortName="DuplicatePrimaryFunction"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="skyhanni.plugin.areas.event.primary.DuplicatePrimaryFunctionInspection"/>

        <localInspection
            language="kotlin"
            groupKey="inspection.group.skyhanni"
            key="inspection.skyHanniModule.displayName"
            bundle="messages.SkyHanniBundle"
            shortName="SkyHanniModuleInspection"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="skyhanni.plugin.areas.misc.SkyHanniModuleInspection"/>

        <localInspection
            language="kotlin"
            groupKey="inspection.group.skyhanni"
            key="inspection.copyConfigPath.displayName"
            bundle="messages.SkyHanniBundle"
            shortName="CopyConfigPath"
            enabledByDefault="true"
            level="INFORMATION"
            implementationClass="skyhanni.plugin.areas.config.CopyConfigPathInspection"/>

        <!-- Reference contributors -->
        <psi.referenceContributor
            language="kotlin"
            implementation="skyhanni.plugin.areas.config.ConfigPathReferenceContributor"/>

        <psi.referenceContributor
            language="kotlin"
            implementation="skyhanni.plugin.areas.event.primary.PrimaryFunctionReferenceContributor"/>

        <!-- Completion -->
        <completion.contributor
            language="kotlin"
            order="first, before KotlinCompletionContributor"
            implementationClass="skyhanni.plugin.areas.event.EventHandlerCompletionContributor"/>

        <!-- Intentions -->
        <intentionAction>
            <language>kotlin</language>
            <className>skyhanni.plugin.areas.config.ConvertConfigToPropertyIntention</className>
            <bundleName>messages.SkyHanniBundle</bundleName>
            <categoryKey>intention.category.skyhanni</categoryKey>
        </intentionAction>

        <intentionAction>
            <language>kotlin</language>
            <className>skyhanni.plugin.areas.config.NavigateToConfigIntention</className>
            <bundleName>messages.SkyHanniBundle</bundleName>
            <categoryKey>intention.category.skyhanni</categoryKey>
        </intentionAction>

        <intentionAction>
            <language>kotlin</language>
            <className>skyhanni.plugin.areas.config.CreateConfigMigrationIntention</className>
            <bundleName>messages.SkyHanniBundle</bundleName>
            <categoryKey>intention.category.skyhanni</categoryKey>
        </intentionAction>

        <!-- Spellchecking -->
        <spellchecker.support
            language="kotlin"
            implementationClass="skyhanni.plugin.areas.misc.SkyHanniSpellcheckingStrategy"/>


        <lang.inspectionSuppressor
            language="kotlin"
            implementationClass="skyhanni.plugin.areas.misc.SkyHanniInspectionSuppressor"/>

        <lang.inspectionSuppressor
            language="JAVA"
            implementationClass="skyhanni.plugin.areas.mixin.MixinInspectionSuppressor"/>

        <!-- Implicit usages -->
        <implicitUsageProvider
            implementation="skyhanni.plugin.areas.mixin.MixinImplicitUsageProvider"/>
    </extensions>
</idea-plugin>
